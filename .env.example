# ─────────────────────────────────────────────────────────────
#  GOUNASS LUXURY — variables d'environnement
#  Copiez ce fichier en .env.local (développement) et renseignez
#  les mêmes clés dans Vercel > Project > Settings > Environment Variables.
#  Ne commitez JAMAIS un fichier contenant de vraies clés.
# ─────────────────────────────────────────────────────────────

# URL publique du site (sans slash final) — utilisée pour les redirections de paiement et le SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : SERVEUR UNIQUEMENT (jamais préfixée NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# ── Wave Business (https://developer.wave.com) ───────────────
WAVE_API_KEY=
# Secret de signature du webhook (Wave Business Portal > Développeurs > Webhooks)
WAVE_WEBHOOK_SECRET=

# ── Orange Money Sénégal — API Sonatel (https://developer.orange-sonatel.com)
ORANGE_MONEY_BASE_URL=https://api.orange-sonatel.com
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_CODE=
ORANGE_MONEY_MERCHANT_NAME=GOUNASS LUXURY
# Jeton aléatoire long que vous ajoutez à l'URL de callback déclarée chez Sonatel
ORANGE_MONEY_WEBHOOK_TOKEN=

# ── Carte bancaire — Stripe Checkout (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── WhatsApp Business Cloud API (https://developers.facebook.com/docs/whatsapp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Modèle approuvé utilisé pour les messages initiés par la boutique (3 variables : nom, n° commande, message)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=fr
# Numéro (format international sans +) qui reçoit les alertes de nouvelles commandes
WHATSAPP_ADMIN_NUMBER=

# ── E-mails transactionnels — Resend (facultatif, https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="GOUNASS LUXURY <commandes@votredomaine.com>"
