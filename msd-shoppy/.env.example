# MSD Shoppy — variables d'environnement
# Copier en .env.local (développement) et renseigner les mêmes clés dans Vercel > Settings > Environment Variables.
# Ne jamais committer un fichier contenant de vraies clés.

# Adresse publique du site, sans slash final (liens partagés, SEO, e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API) — projet DÉDIÉ à MSD Shoppy
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role : SERVEUR UNIQUEMENT (envoi des images, suppression de compte). Jamais préfixée NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Adresse affichée pour l'assistance (facultatif)
NEXT_PUBLIC_SUPPORT_EMAIL=
